---
import Layout from "../layouts/Layout.astro";
import { safeNextPath } from "../lib/paths";

const next = safeNextPath(Astro.url.searchParams.get("next"));

// Already signed in? Go straight in
if (await Astro.session?.get("user")) {
  return Astro.redirect(next);
}

const ERRORS: Record<string, string> = {
  "sign-in-failed": "Signing in didn't work. Try again.",
  "users-tab":
    "Google signed you in, but the app couldn't read its list of users. Ask an admin to check the spreadsheet's Users tab.",
};
const error = ERRORS[Astro.url.searchParams.get("error") ?? ""];
const signInUrl = `/auth/google?next=${encodeURIComponent(next)}`;
---

<Layout title="Sign in">
  <main class="page sign-in">
    <div class="card">
      <img src="/icons/icon-192.png" alt="" width="88" height="88" />
      <div>
        <h1>Clubhouse bookings</h1>
        <p class="lede">For the Helderberg Pirates committee.</p>
      </div>
      {error && (
        <p class="error" role="alert">
          {error}
        </p>
      )}
      <a class="button button-primary" href={signInUrl}>
        Sign in with Google
      </a>
    </div>
    <a class="privacy-link" href="/privacy">
      Privacy policy
    </a>
  </main>
</Layout>

<style>
  .sign-in {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 1.25rem;
    min-height: 100dvh;
  }
  .card {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    width: 100%;
    max-width: 24rem;
    padding: 2rem 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    text-align: center;
  }
  .card img {
    border-radius: 50%;
    background: #ffffff;
  }
  h1 {
    margin: 0;
    font-size: 1.5rem;
  }
  .lede {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
  }
  .error {
    margin: 0;
    padding: 0.75rem 1rem;
    border-radius: var(--radius-small);
    background: var(--color-danger-soft);
    color: var(--color-danger);
  }
  .button {
    width: 100%;
  }
  .privacy-link {
    color: var(--color-muted);
    font-size: 0.875rem;
  }
</style>
