---
import BookingDetails from "../../components/BookingDetails.astro";
import Icon from "../../components/Icon.astro";
import AppLayout from "../../layouts/AppLayout.astro";
import { loadBookings } from "../../lib/data";
import { todayInSouthAfrica } from "../../lib/dates";

const { user } = Astro.locals;
const today = todayInSouthAfrica();

const bookings = await loadBookings();
const booking = bookings.find((b) => b.id === Astro.params.id);
if (!booking) {
  Astro.response.status = 404;
}
---

<AppLayout title={booking?.name || "Booking not found"} user={user}>
  <a class="back" href="/" data-back>
    <Icon name="chevron-left" size={20} />
    Bookings
  </a>

  {booking ? (
    <BookingDetails
      booking={booking}
      today={today}
      canSeeIdNumber={user.permissions.editDetails}
    />
  ) : (
    <div class="not-found">
      <h1>Booking not found</h1>
      <p>It may have been removed from the spreadsheet.</p>
    </div>
  )}
</AppLayout>

<script>
  // Back to the list as you left it (same tab, search and scroll position),
  // when you came from it
  const back = document.querySelector<HTMLAnchorElement>("[data-back]");
  back?.addEventListener("click", (event) => {
    const from = document.referrer ? new URL(document.referrer) : null;
    if (from?.origin === location.origin && from.pathname === "/") {
      event.preventDefault();
      history.back();
    }
  });
</script>

<style>
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: var(--tap-size);
    margin: -0.5rem 0 0.25rem -0.375rem;
    padding-right: 0.5rem;
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .not-found h1 {
    margin: 0.5rem 0;
  }
  .not-found p {
    color: var(--color-muted);
  }
</style>
