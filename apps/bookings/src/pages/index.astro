---
import BookingList from "../components/BookingList.astro";
import AppLayout from "../layouts/AppLayout.astro";
import {
  bookingsToShow,
  countHidden,
  countsByWhen,
  groupByMonth,
  parseShowCalledOff,
  parseWhen,
} from "../lib/booking-list";
import { loadBookingData, type BookingData } from "../lib/data";
import { todayInSouthAfrica } from "../lib/dates";

const { user } = Astro.locals;
const today = todayInSouthAfrica();
const when = parseWhen(Astro.url.searchParams.get("when"));
const search = (Astro.url.searchParams.get("q") ?? "").trim();
const showCalledOff = parseShowCalledOff(
  Astro.url.searchParams.get("cancelled")
);

let data: BookingData | undefined;
try {
  data = await loadBookingData();
} catch (error) {
  console.error("Couldn't load the bookings", error);
}
const bookings = data?.bookings ?? [];

const filters = { when, search, showCalledOff, today };
const groups = groupByMonth(bookingsToShow(bookings, filters));
const counts = countsByWhen(bookings, filters);
const hiddenCount = countHidden(bookings, filters);
---

<AppLayout title="Bookings" user={user}>
  <BookingList
    groups={groups}
    counts={counts}
    when={when}
    search={search}
    showCalledOff={showCalledOff}
    hiddenCount={hiddenCount}
    today={today}
    failed={!data}
    outOfLineRows={data?.tracking.outOfLineRows}
  />
</AppLayout>
