---
import BookingList from "../components/BookingList.astro";
import AppLayout from "../layouts/AppLayout.astro";
import {
  bookingsToShow,
  countsByWhen,
  groupByMonth,
  parseWhen,
} from "../lib/booking-list";
import type { Booking } from "../lib/bookings";
import { loadBookings } from "../lib/data";
import { todayInSouthAfrica } from "../lib/dates";

const { user } = Astro.locals;
const today = todayInSouthAfrica();
const when = parseWhen(Astro.url.searchParams.get("when"));
const search = (Astro.url.searchParams.get("q") ?? "").trim();

let bookings: Booking[] = [];
let failed = false;
try {
  bookings = await loadBookings();
} catch (error) {
  console.error("Couldn't load the bookings", error);
  failed = true;
}

const groups = groupByMonth(bookingsToShow(bookings, { when, search, today }));
const counts = countsByWhen(bookings, search, today);
---

<AppLayout title="Bookings" user={user}>
  <BookingList
    groups={groups}
    counts={counts}
    when={when}
    search={search}
    today={today}
    failed={failed}
  />
</AppLayout>
