---
// One booking in the list: its date, who it's for, the function, the time,
// and where it stands
import { timeRange } from "../lib/bookings";
import { dayOfMonth, monthShort, weekdayShort } from "../lib/dates";
import { isCalledOff, isConfirmed, type TrackedBooking } from "../lib/tracking";
import Icon from "./Icon.astro";
import StatusTag from "./StatusTag.astro";

interface Props {
  booking: TrackedBooking;
  today: string;
}

const { booking, today } = Astro.props;
const isToday = booking.date === today;
const isPast = booking.date !== null && booking.date < today;
const isCancelled = isCalledOff(booking.tracking);
const time = timeRange(booking);
---

<a
  class:list={[
    "card",
    { "is-today": isToday, "is-past": isPast, "is-cancelled": isCancelled },
  ]}
  href={`/bookings/${booking.id}`}
>
  <div class="date">
    {booking.date ? (
      <>
        <span class="weekday">{weekdayShort(booking.date)}</span>
        <span class="day">{dayOfMonth(booking.date)}</span>
        {isToday && <span class="visually-hidden">Today</span>}
        <span class="month">{monthShort(booking.date)}</span>
      </>
    ) : (
      <span class="weekday">No date</span>
    )}
  </div>

  <div class="body">
    <div class="who">
      <strong class="name">{booking.name || "No name given"}</strong>
      <span class="function">
        {booking.functionType || "No function type given"}
      </span>
    </div>
    <div class="meta">
      <span class="time">
        <Icon name="clock" size={16} />
        {time ?? "Time not given"}
      </span>
      <span class="tags">
        {isConfirmed(booking.tracking) && <StatusTag status="Confirmed" />}
        <StatusTag status={booking.tracking.status} />
        {booking.isMember && <span class="tag">Member</span>}
      </span>
    </div>
  </div>

  <span class="chevron">
    <Icon name="chevron-right" size={20} />
  </span>
</a>

<style>
  .card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.875rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
    color: var(--color-text);
    text-decoration: none;
    transition: border-color 0.15s;
  }
  .card:hover {
    border-color: var(--color-primary);
  }

  .date {
    display: grid;
    justify-items: center;
    align-content: center;
    width: 3.5rem;
    min-height: 4rem;
    padding: 0.375rem 0;
    border-radius: var(--radius-small);
    background: var(--color-primary-soft);
    color: var(--color-primary);
    line-height: 1.15;
    text-align: center;
  }
  .weekday,
  .month {
    font-size: 0.6875rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .day {
    font-size: 1.375rem;
    font-weight: 800;
    font-variant-numeric: tabular-nums;
  }
  .is-today .date {
    background: var(--color-primary);
    color: var(--color-on-primary);
  }
  .is-cancelled {
    opacity: 0.65;
  }
  .is-cancelled .name {
    text-decoration: line-through;
  }
  .is-past .date,
  .is-cancelled .date {
    background: var(--color-surface-sunken);
    color: var(--color-muted);
  }

  .body {
    display: grid;
    gap: 0.375rem;
    min-width: 0;
  }
  .who {
    display: grid;
    min-width: 0;
  }
  .name {
    overflow: hidden;
    font-size: 1rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .function {
    overflow: hidden;
    color: var(--color-muted);
    font-size: 0.9375rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.375rem 0.75rem;
  }
  .time {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
  }
  .chevron {
    display: flex;
    color: var(--color-muted);
  }
  /* The tapped card shows a spinner in place of its arrow */
  .card[aria-busy="true"] {
    border-color: var(--color-primary);
  }
  .card[aria-busy="true"] .chevron :global(.icon) {
    display: none;
  }
  .card[aria-busy="true"] .chevron::before {
    content: "";
    width: 1.125rem;
    height: 1.125rem;
    border: 2px solid var(--color-primary);
    border-right-color: transparent;
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  /* Wider screens: name, time and tags side by side */
  @media (min-width: 48rem) {
    .card {
      padding: 0.75rem 1rem;
      gap: 1.25rem;
    }
    .body {
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
      align-items: center;
      gap: 1.25rem;
    }
  }
</style>
