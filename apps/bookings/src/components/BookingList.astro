---
// The bookings list: search, the Upcoming / Past / All tabs, and the bookings
// grouped by month
import { WHEN_LABELS, type MonthGroup, type When } from "../lib/booking-list";
import type { TrackedBooking } from "../lib/tracking";
import Alert from "./Alert.astro";
import BookingCard from "./BookingCard.astro";
import Icon from "./Icon.astro";

interface Props {
  groups: MonthGroup<TrackedBooking>[];
  counts: Record<When, number>;
  when: When;
  search: string;
  today: string;
  /** True when the spreadsheet couldn't be read */
  failed?: boolean;
  /** "Tracking Data" rows that no longer line up with the form responses */
  outOfLineRows?: number[];
}

const {
  groups,
  counts,
  when,
  search,
  today,
  failed = false,
  outOfLineRows = [],
} = Astro.props;
const shownCount = groups.reduce(
  (total, group) => total + group.bookings.length,
  0
);

// Links keep the search when switching tab. Upcoming is the default, so it
// needs no "when" in the address.
function linkTo(nextWhen: When, nextSearch: string): string {
  const params = new URLSearchParams();
  if (nextWhen !== "upcoming") params.set("when", nextWhen);
  if (nextSearch) params.set("q", nextSearch);
  const query = params.toString();
  return query ? `/?${query}` : "/";
}

const plural = (count: number, word: string) =>
  `${count} ${word}${count === 1 ? "" : "s"}`;
const summary = search
  ? `${plural(shownCount, "booking")} matching “${search}”`
  : {
      upcoming: `${plural(shownCount, "upcoming booking")}`,
      past: `${plural(shownCount, "past booking")}`,
      all: `${plural(shownCount, "booking")} in total`,
    }[when];
---

<h1 class="visually-hidden">Bookings</h1>

{outOfLineRows.length > 0 && (
  <div class="banner">
    <Alert tone="warning" title="Saving is paused">
      <p>
        "Tracking Data" no longer lines up with "Form responses 1" (row{" "}
        {outOfLineRows.join(", ")}). Bookings still show correctly. Ask an admin
        to line the rows up again.
      </p>
    </Alert>
  </div>
)}

<div class="controls">
  <form class="search" method="get" role="search" data-search-form>
    <label class="visually-hidden" for="search">
      Search bookings
    </label>
    <Icon name="search" size={20} />
    <input
      id="search"
      type="search"
      name="q"
      value={search}
      placeholder="Search name, phone, function…"
      autocomplete="off"
      enterkeyhint="search"
    />
    {when !== "upcoming" && <input type="hidden" name="when" value={when} />}
  </form>

  <nav class="tabs" aria-label="Which bookings to show">
    {(Object.keys(WHEN_LABELS) as When[]).map((tab) => (
      <a
        href={linkTo(tab, search)}
        aria-current={tab === when ? "page" : undefined}
      >
        {WHEN_LABELS[tab]}
        <span class="count">{counts[tab]}</span>
      </a>
    ))}
  </nav>
</div>

{failed ? (
  <div class="empty" role="alert">
    <Icon name="alert" size={32} />
    <h2>Couldn't load the bookings</h2>
    <p>
      Check your connection and try again. If it keeps happening, tell a
      committee admin.
    </p>
    <a class="button" href={linkTo(when, search)}>
      Try again
    </a>
  </div>
) : groups.length === 0 ? (
  <div class="empty">
    <Icon name="inbox" size={32} />
    <h2>
      {search
        ? "No bookings match your search"
        : when === "upcoming"
          ? "No upcoming bookings"
          : "No bookings"}
    </h2>
    {search ? (
      <a class="button" href={linkTo(when, "")}>
        Clear the search
      </a>
    ) : (
      when === "upcoming" &&
      counts.past > 0 && (
        <a class="button" href={linkTo("past", "")}>
          Show past bookings
        </a>
      )
    )}
  </div>
) : (
  <>
    <p class="summary" aria-live="polite">
      {summary}
      {search && <a href={linkTo(when, "")}>Clear</a>}
    </p>
    {groups.map((group) => (
      <section class="month" aria-label={group.label}>
        <h2>{group.label}</h2>
        <ul class="cards">
          {group.bookings.map((booking) => (
            <li>
              <BookingCard booking={booking} today={today} />
            </li>
          ))}
        </ul>
      </section>
    ))}
  </>
)}

<script>
  // Clearing the search box (its ✕ button) shows everything again straight
  // away. Pressing Enter searches as a normal form.
  const form = document.querySelector<HTMLFormElement>("[data-search-form]");
  const input = form?.querySelector<HTMLInputElement>("input[type=search]");
  input?.addEventListener("search", () => {
    if (input.value === "") form?.requestSubmit();
  });
</script>

<style>
  .banner {
    margin-bottom: 1rem;
  }
  .controls {
    display: grid;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .search {
    position: relative;
    display: flex;
    align-items: center;
    color: var(--color-muted);
  }
  .search :global(.icon) {
    position: absolute;
    left: 0.875rem;
    pointer-events: none;
  }
  .search input {
    width: 100%;
    padding: 0 0.875rem 0 2.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-card);
  }
  .search input::placeholder {
    color: var(--color-muted);
  }
  .search input:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 0;
    border-color: var(--color-primary);
  }

  .tabs {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.25rem;
    padding: 0.25rem;
    border-radius: var(--radius);
    background: var(--color-surface-sunken);
  }
  .tabs a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    min-height: 2.5rem;
    border-radius: var(--radius-small);
    color: var(--color-muted);
    font-weight: 600;
    text-decoration: none;
  }
  .tabs a[aria-current="page"] {
    background: var(--color-surface);
    color: var(--color-text);
    box-shadow: var(--shadow-card);
  }
  .count {
    min-width: 1.5rem;
    padding: 0 0.375rem;
    border-radius: 999px;
    background: var(--color-surface-sunken);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.5rem;
    text-align: center;
  }
  .tabs a[aria-current="page"] .count {
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .summary {
    display: flex;
    gap: 0.75rem;
    margin: 0 0 0.5rem;
    color: var(--color-muted);
    font-size: 0.875rem;
  }

  .month h2 {
    /* Stays under the top bar while its month scrolls past */
    position: sticky;
    top: 3.5rem;
    z-index: 1;
    margin: 0;
    padding: 0.75rem 0 0.5rem;
    background: var(--color-background);
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .cards {
    display: grid;
    gap: 0.5rem;
    margin: 0 0 0.75rem;
    padding: 0;
    list-style: none;
  }

  .empty {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    padding: 3rem 1rem;
    color: var(--color-muted);
    text-align: center;
  }
  .empty h2 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.125rem;
  }
  .empty p {
    max-width: 28rem;
    margin: 0;
  }

  /* Wider screens: the search and the tabs share a row */
  @media (min-width: 48rem) {
    .controls {
      grid-template-columns: minmax(0, 1fr) 20rem;
      align-items: center;
    }
  }
</style>
