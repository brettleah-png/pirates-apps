---
// Everything about one booking: when, how to reach the person, where it
// stands, their answers on the form, and its history
import { actions } from "astro:actions";
import {
  durationInMinutes,
  durationLabel,
  formatPhone,
  timeRange,
} from "../lib/bookings";
import { longDate, relativeDay, shortDate, shortDateTime } from "../lib/dates";
import type { HistoryEntry } from "../lib/history";
import {
  canDeleteIdNumber,
  editableFields,
  isConfirmed,
  type TrackedBooking,
} from "../lib/tracking";
import type { SignedInUser } from "../lib/users";
import Alert from "./Alert.astro";
import BookingHistory from "./BookingHistory.astro";
import CopyButton from "./CopyButton.astro";
import Icon from "./Icon.astro";
import StatusTag from "./StatusTag.astro";

interface Props {
  booking: TrackedBooking;
  today: string;
  user: SignedInUser;
  /** Other confirmed bookings on the same date */
  clashes: TrackedBooking[];
  history: HistoryEntry[];
  /** Now, as a Sheets date-and-time number */
  now: number;
  /** A note that couldn't be saved */
  noteError?: string;
}

const { booking, today, user, clashes, history, now, noteError } = Astro.props;
const { tracking } = booking;
const time = timeRange(booking);
const duration = durationInMinutes(booking);
const phone = formatPhone(booking.phone);
const allContactDetails = [booking.name, phone, booking.email]
  .filter(Boolean)
  .join("\n");
const isPast = booking.date !== null && booking.date < today;
const canEdit = editableFields(user.permissions).length > 0;
// ID numbers are only shown to people who can edit booking details
const canSeeIdNumber = user.permissions.editDetails;
const showDeleteIdNumber = canSeeIdNumber && canDeleteIdNumber(booking, today);
const submitted = booking.submittedDate
  ? `${shortDate(booking.submittedDate)}${booking.submittedTime ? `, ${booking.submittedTime}` : ""}`
  : "Unknown";
const lastSavedBy =
  tracking.updatedBy.toLowerCase() === user.email.toLowerCase()
    ? "you"
    : tracking.updatedBy;
---

<article class="booking">
  <header class="heading">
    <div class="heading-text">
      <h1>{booking.name || "No name given"}</h1>
      <p class="function">{booking.functionType || "No function type given"}</p>
      <div class="tags">
        {isConfirmed(tracking) && <StatusTag status="Confirmed" />}
        <StatusTag status={tracking.status} />
        {booking.isMember && <span class="tag">Club member</span>}
        {isPast && <span class="tag">Past</span>}
      </div>
    </div>
    {canEdit && (
      <a class="button" href={`/bookings/${booking.id}/edit`}>
        <Icon name="edit" size={18} />
        Edit
      </a>
    )}
  </header>

  {clashes.length > 0 && booking.date && (
    <Alert tone="warning" title="This date is already taken">
      <p>
        {clashes.length === 1
          ? "Another booking is"
          : `${clashes.length} other bookings are`}{" "}
        confirmed on {longDate(booking.date)}:{" "}
        {clashes.map((other, index) => (
          <>
            {index > 0 && ", "}
            <a href={`/bookings/${other.id}`}>
              {other.name || "No name given"}
              {timeRange(other) && ` (${timeRange(other)})`}
            </a>
          </>
        ))}
      </p>
    </Alert>
  )}

  <div class="columns">
    <div class="column">
      <section class="panel" aria-label="When">
        <div class="when-row">
          <span class="when-icon">
            <Icon name="calendar" />
          </span>
          <div>
            <strong>
              {booking.date ? longDate(booking.date) : "No date given"}
            </strong>
            {booking.date && <span>{relativeDay(booking.date, today)}</span>}
          </div>
        </div>
        <div class="when-row">
          <span class="when-icon">
            <Icon name="clock" />
          </span>
          <div>
            <strong>{time ?? "No time given"}</strong>
            {duration !== null && (
              <span>
                {durationLabel(duration)}
                {booking.endsNextDay && " · ends the next day"}
              </span>
            )}
          </div>
        </div>
      </section>

      <section class="panel">
        <h2>Contact</h2>
        <dl class="rows">
          <div class="row">
            <dt>Name</dt>
            <dd>
              <span class="value">{booking.name || "—"}</span>
              {booking.name && <CopyButton value={booking.name} label="name" />}
            </dd>
          </div>
          <div class="row">
            <dt>Phone</dt>
            <dd>
              {booking.phone ? (
                <a
                  class="value"
                  href={`tel:${booking.phone.replace(/[^\d+]/g, "")}`}
                >
                  {phone}
                </a>
              ) : (
                <span class="value">—</span>
              )}
              {booking.phone && (
                <CopyButton value={phone} label="phone number" />
              )}
            </dd>
          </div>
          <div class="row">
            <dt>Email</dt>
            <dd>
              {booking.email ? (
                <a class="value" href={`mailto:${booking.email}`}>
                  {booking.email}
                </a>
              ) : (
                <span class="value">—</span>
              )}
              {booking.email && (
                <CopyButton value={booking.email} label="email address" />
              )}
            </dd>
          </div>
        </dl>
        <CopyButton
          value={allContactDetails}
          label="all contact details"
          text="Copy all contact details"
        />
      </section>

      <section class="panel">
        <h2>Tracking</h2>
        <dl class="rows">
          <div class="row">
            <dt>Status</dt>
            <dd>
              <span class="value">{tracking.status}</span>
            </dd>
          </div>
          <div class="row">
            <dt>Payment status</dt>
            <dd>
              <span class="value">{tracking.paymentStatus}</span>
            </dd>
          </div>
          <div class="row">
            <dt>Invoice number</dt>
            <dd>
              <span class="value">{tracking.invoiceNumber || "—"}</span>
            </dd>
          </div>
          <div class="row">
            <dt>Damage deposit</dt>
            <dd>
              <span class="value">{tracking.damageDeposit}</span>
            </dd>
          </div>
          {tracking.damageDeposit === "Refunded" && (
            <>
              <div class="row">
                <dt>Amount kept back</dt>
                <dd>
                  <span class="value">
                    {tracking.damageKeptBack
                      ? `R ${tracking.damageKeptBack}`
                      : "Nothing"}
                  </span>
                </dd>
              </div>
              {tracking.damageNote && (
                <div class="row">
                  <dt>Damage</dt>
                  <dd>
                    <span class="value multiline">{tracking.damageNote}</span>
                  </dd>
                </div>
              )}
            </>
          )}
        </dl>
        {tracking.updatedAt !== null && (
          <p class="note">
            Last saved by {lastSavedBy || "someone"},{" "}
            {shortDateTime(tracking.updatedAt)}.
          </p>
        )}
      </section>
    </div>

    <div class="column">
      <section class="panel">
        <h2>From the booking form</h2>
        <dl class="rows">
          <div class="row">
            <dt>Special considerations</dt>
            <dd>
              <span class="value multiline">
                {booking.specialConsiderations || "None"}
              </span>
            </dd>
          </div>
          <div class="row">
            <dt>Club member</dt>
            <dd>
              <span class="value">{booking.isMember ? "Yes" : "No"}</span>
            </dd>
          </div>
          <div class="row">
            <dt>Terms and conditions</dt>
            <dd>
              <span class="value">
                {booking.acceptedTerms ? "Accepted" : "Not accepted"}
              </span>
            </dd>
          </div>
          {canSeeIdNumber && (
            <div class="row">
              <dt>ID number</dt>
              <dd class="id-number-cell">
                <span class="value id-number">{booking.idNumber || "—"}</span>
                {showDeleteIdNumber && (
                  <details class="delete-id">
                    <summary>
                      <Icon name="trash" size={16} />
                      Delete ID number
                    </summary>
                    <div class="delete-id-confirm">
                      <p>
                        The club no longer needs it. This clears it from "Form
                        responses 1" and can't be undone. Google Forms keeps its
                        own copy of the response.
                      </p>
                      <form method="POST" action={actions.deleteIdNumber}>
                        <input
                          type="hidden"
                          name="bookingId"
                          value={booking.id}
                        />
                        <button class="button button-danger" type="submit">
                          Delete it permanently
                        </button>
                      </form>
                    </div>
                  </details>
                )}
              </dd>
            </div>
          )}
          <div class="row">
            <dt>Requested</dt>
            <dd>
              <span class="value">{submitted}</span>
            </dd>
          </div>
        </dl>
      </section>

      <BookingHistory
        bookingId={booking.id}
        entries={history}
        user={user}
        now={now}
        error={noteError}
      />
    </div>
  </div>

  <p class="visually-hidden" aria-live="polite" data-copy-status></p>
</article>

<style>
  .booking {
    display: grid;
    gap: 1rem;
  }

  .heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }
  .heading h1 {
    margin: 0;
    font-size: 1.625rem;
  }
  .function {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
    font-size: 1.0625rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }
  .heading .button {
    flex: none;
  }

  .columns,
  .column {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .booking :global(.panel) {
    display: grid;
    gap: 0.75rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    box-shadow: var(--shadow-card);
  }
  .booking :global(.panel h2) {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .when-row {
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .when-row div {
    display: grid;
  }
  .when-row strong {
    font-size: 1.0625rem;
    font-variant-numeric: tabular-nums;
  }
  .when-row span {
    color: var(--color-muted);
    font-size: 0.9375rem;
  }
  .when-icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: var(--radius-small);
    background: var(--color-primary-soft);
    color: var(--color-primary);
  }

  .rows {
    display: grid;
    margin: 0;
  }
  .row {
    display: grid;
    gap: 0.125rem;
    padding: 0.625rem 0;
    border-top: 1px solid var(--color-border);
  }
  .row:first-child {
    border-top: 0;
    padding-top: 0;
  }
  dt {
    color: var(--color-muted);
    font-size: 0.8125rem;
    font-weight: 600;
  }
  dd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0;
  }
  .value {
    min-width: 0;
    overflow-wrap: anywhere;
  }
  a.value {
    color: var(--color-primary);
    font-weight: 600;
    text-decoration: none;
  }
  .multiline {
    white-space: pre-line;
  }
  .id-number {
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
  }
  .note {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.8125rem;
  }

  .id-number-cell {
    flex-wrap: wrap;
  }
  .delete-id {
    flex: 1 1 100%;
  }
  .delete-id summary {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    min-height: 2.25rem;
    color: var(--color-danger);
    font-size: 0.875rem;
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .delete-id summary::-webkit-details-marker {
    display: none;
  }
  .delete-id-confirm {
    display: grid;
    gap: 0.75rem;
    padding: 0.75rem;
    border-radius: var(--radius-small);
    background: var(--color-danger-soft);
    color: var(--color-danger);
    font-size: 0.9375rem;
  }
  .delete-id-confirm p {
    margin: 0;
  }
  .button-danger {
    border-color: var(--color-danger);
    background: var(--color-danger);
    /* White on light mode's dark red, near-black on dark mode's light red */
    color: var(--color-surface);
  }

  /* Wider screens: two columns, and labels beside their values */
  @media (min-width: 56rem) {
    .heading h1 {
      font-size: 2rem;
    }
    .columns {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .row {
      grid-template-columns: 9.5rem minmax(0, 1fr);
      align-items: center;
      gap: 1rem;
    }
  }
</style>
