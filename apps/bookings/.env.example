# Copy this file to .env and fill in the values. Git ignores .env.
# Netlify needs the same five settings under Project configuration →
# Environment variables. Never commit the real values.

# Google Cloud → Google Auth Platform → Clients → "Bookings app"
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Cloud → IAM & Admin → Service Accounts → "bookings-app"
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" value from the service account's JSON key file, exactly as
# it appears there, including every \n, inside double quotes
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# The long ID in the spreadsheet's address, between /d/ and /edit. Locally and
# until the app goes live, use the test copy with made-up data.
SPREADSHEET_ID=
